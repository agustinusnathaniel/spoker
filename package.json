{
  "name": "spoker",
  "version": "1.17.7",
  "private": true,
  "author": "agustinusnathaniel",
  "engines": {
    "node": "^24.11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "turbo": "pnpm dlx turbo@2.6.3",
    "build:turbo": "pnpm turbo build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "start": "next start",
    "type:check": "tsc --noEmit",
    "ultracite:check": "ultracite check",
    "ultracite:fix": "ultracite fix",
    "check:turbo": "pnpm turbo ultracite:check type:check",
    "check:unused": "knip",
    "release": "cross-env HUSKY=0 commit-and-tag-version",
    "push-release": "git push --follow-tags origin dev",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L",
    "generate-rules": "ts-node tools/generate-rules.ts",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@fontsource/gabarito": "^5.2.8",
    "@fontsource/gantari": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@sentry/nextjs": "^10.59.0",
    "firebase": "^12.15.0",
    "lodash-es": "^4.18.1",
    "nanoid": "^5.1.14",
    "next": "16.2.9",
    "next-seo": "^7.2.0",
    "next-themes": "^0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-fast-compare": "^3.2.2",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.6.0",
    "react-rewards": "^2.1.0",
    "react-textarea-autosize": "^8.5.9",
    "twemoji": "14.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/cz-commitlint": "^20.5.3",
    "@commitlint/types": "^21.0.1",
    "@eslint/eslintrc": "^3.3.5",
    "@jahed/firebase-rules": "^2.1.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.4",
    "@types/react": "19.2.14",
    "all-contributors-cli": "^6.26.1",
    "commit-and-tag-version": "^12.7.3",
    "commitizen": "^4.3.2",
    "commitlint": "^20.5.3",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.8",
    "next-sitemap": "^4.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "ultracite": "7.6.1"
  },
  "repository": {
    "url": "https://github.com/agustinusnathaniel/spoker"
  },
  "nextBundleAnalysis": {
    "budget": null,
    "budgetPercentIncreaseRed": 20,
    "showDetails": true
  }
}
